# Copy this file to .env and fill in the values. Never commit .env.

# Connection string for MongoDB (the host "mongodb" is the Docker Compose service name)
MONGODB_URI=mongodb://mongodb:27017/CalendarDB

# Port for the Node API server
PORT=5000

# Secret used to sign login tokens. Use a long random value, for example the
# output of:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts (examples: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Key that encrypts event/reminder titles and notes in the database: 64 hex
# characters. Everyone sharing a database must use the same key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=
